# Copy this file to .env and replace the placeholder values before starting the backend.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Ollama (local model) settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b

# Provider: "auto" (Ollama first, Gemini fallback), "ollama", or "gemini"
PROVIDER=auto
